option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'Select shared or static dependency linkage',
)

option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build contract tests',
)


option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build and install committed generated manual pages',
)

option(
  'html_docs',
  type: 'feature',
  value: 'disabled',
  description: 'Generate and install versioned static HTML documentation',
)
